              "loft/interface-monitoring",
              "loft/alerting"
            ]
          },
          {
            "group": "Guides & Tutorials",
            "icon": "book-open",
            "pages": [
              "guides/generate-realistic-test-data",
              "guides/de-identify-real-messages",
              "guides/build-test-scenarios",
              "guides/monitor-mirth-with-loft",
              "guides/seed-database-with-flock"
