              "getting-started/quickstart-desktop",
              "getting-started/account"
            ]
          },
          {
            "group": "Install",
            "icon": "download",
            "pages": [
              "getting-started/install-windows",
              "getting-started/install-macos"
            ]
          },
          {
            "group": "Desktop Apps",
            "icon": "grid-2",
            "pages": [
              "getting-started/launcher",
              "getting-started/post",
              "getting-started/flock",
              "getting-started/loft",
              "getting-started/migrate"
            ]
          },
          {
            "group": "Post (Testing Tool)",
            "icon": "paper-plane",
            "pages": [
              "post/message-generation",
